# ==========================================
# LLM / Chat Model API (OpenAI Compatible)
# ==========================================
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-openai-or-deepseek-api-key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ==========================================
# Embedding Model API (OpenAI Compatible)
# ==========================================
# e.g., OpenAI (text-embedding-3-small) / SiliconFlow (BAAI/bge-m3) / DashScope
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ==========================================
# Reranker Model API (Cross-Encoder / API)
# ==========================================
# Supports SiliconFlow / Jina / BGE API. If left empty, local RRF score is used.
RERANKER_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ==========================================
# Storage & Chunking Settings
# ==========================================
VECTOR_PERSIST_DIR=./data/vector_indices
BM25_PERSIST_DIR=./data/bm25_indices
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# ==========================================
# Server Settings
# ==========================================
HOST=0.0.0.0
PORT=8000
